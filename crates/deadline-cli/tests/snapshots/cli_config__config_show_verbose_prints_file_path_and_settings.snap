   The storage profile that this workstation conforms to.

defaults.queue_id:  (default)
   The Queue ID to use by default.

defaults.job_id:  (default)
   The Job ID to use by default.

settings.auto_accept: false (default)
   Automatically accept the default choice for any interactive prompts.

settings.conflict_resolution: NOT_SELECTED (default)
   How to handle downloads if a file already exists.

settings.log_level: WARNING (default)
   The logging level to use in the CLI and GUIs.

telemetry.opt_out: false (default)
   If set to 'true', don't record any telemetry events.

telemetry.identifier:  (default)
   A randomly generated identifier used to record telemetry events.

defaults.job_attachments_file_system: COPIED (default)
   The file system mode to use for job attachments when running jobs.

settings.s3_max_pool_connections: 50 (default)
   The maximum number of connections to keep in the S3 connection pool.

settings.small_file_threshold_multiplier: 20 (default)
   Multiplier for calculating the small file size threshold.

settings.known_asset_paths:  (default)
   A list of paths that should not generate warnings when outside storage
   profile locations.

settings.locale:  (default)
   The locale to use for the UI. If empty, uses the system locale.

settings.force_s3_check: false (default)
   Controls S3 verification behavior for job attachments.


